# ── Core API Keys ──────────────────────────────────────────────

# Google Places API (New) — from Google Cloud Console
# Enable: Places API (New)
GOOGLE_PLACES_API_KEY=

# Firecrawl — https://firecrawl.dev (free tier: 500 credits)
FIRECRAWL_API_KEY=
# Requests per minute cap (plan limit is 30; default 28 leaves headroom)
FIRECRAWL_RPM=28

# Apollo.io — BYOK (Bring Your Own Key)
# Users enter their own key in the app. Get one at https://app.apollo.io/settings/api
# Free tier: 900 credits/year

# ── Auth (enable for production) ──────────────────────────────

# Set to "true" to enable Google OAuth login + usage tracking
AUTH_ENABLED=false

# Google OAuth 2.0 Client ID (only needed if AUTH_ENABLED=true)
# Create at: https://console.cloud.google.com/apis/credentials
# Add http://localhost:5000 to Authorized JavaScript origins
# Add http://localhost:5000/auth/google to Authorized redirect URIs
GOOGLE_CLIENT_ID=

# Flask secret key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=

# ── LemonSqueezy Billing ─────────────────────────────────────
# Create products at: https://app.lemonsqueezy.com
# Set up webhook at: https://app.lemonsqueezy.com/settings/webhooks
# Webhook URL: https://yourdomain.com/api/webhooks/lemonsqueezy
# Events: subscription_created, subscription_updated, subscription_cancelled, subscription_expired

LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=

# Product variant IDs (from LemonSqueezy product page URL)
LS_STARTER_VARIANT_ID=
LS_PRO_VARIANT_ID=
LS_AGENCY_VARIANT_ID=

# Product IDs (for webhook tier mapping)
LS_STARTER_PRODUCT_ID=
LS_PRO_PRODUCT_ID=
LS_AGENCY_PRODUCT_ID=

# ── App Config ────────────────────────────────────────────────

TARGET_CITY=Las Vegas, NV
DEFAULT_TIER=starter
